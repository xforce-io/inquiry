{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "requested_url": {
            "type": "string",
            "minLength": 1
          },
          "final_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetch_status": {
            "enum": [
              "captured",
              "unavailable",
              "denied",
              "not_attempted"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "receipt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_slot": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_slot": {
            "type": [
              "string",
              "null"
            ]
          },
          "fact": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string"
              },
              "requested_url": {
                "type": "string"
              },
              "captured_at": {
                "type": "string"
              },
              "fetch_status": {
                "type": "string",
                "enum": [
                  "captured",
                  "unavailable",
                  "denied",
                  "not_attempted"
                ]
              },
              "reason": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "final_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "normalized_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "transform_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "raw_slot": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "snapshot_slot": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "http_status": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "usable": {
                "type": "boolean"
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "source_id",
              "requested_url",
              "captured_at",
              "fetch_status",
              "reason",
              "title",
              "final_url",
              "body_sha256",
              "normalized_sha256",
              "transform_version",
              "raw_slot",
              "snapshot_slot",
              "http_status",
              "usable",
              "truncated"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "source_id",
          "requested_url",
          "final_url",
          "fetch_status",
          "http_status",
          "reason",
          "receipt_id",
          "snapshot_slot",
          "raw_slot",
          "fact"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "items",
    "stop_reason"
  ],
  "additionalProperties": false
}
