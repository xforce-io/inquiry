{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "support": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "counter": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "text",
          "support",
          "counter",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": [
        "ready",
        "need_more",
        "need_input"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "paragraph": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_id": {
            "type": "string",
            "pattern": "^r[12]s[0-9]+$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "paragraph",
          "quote",
          "source_id",
          "id"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "search_queries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 8
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "answered",
              "unknown"
            ]
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "question",
          "status",
          "conclusion",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "judgments",
    "gaps",
    "decision",
    "evidence",
    "search_queries",
    "coverage"
  ],
  "additionalProperties": false
}
